[Unit]
Description=SIS-Leg - backend institucional
After=network.target

[Service]
Type=simple
User=sis-leg-backend
Group=sis-leg-backend
WorkingDirectory=/opt/sis-leg
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/env /opt/sis-leg/current/.venv/bin/uvicorn sis_leg_backend.main:app --app-dir /opt/sis-leg/current/app/apps/backend/src --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=2s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
